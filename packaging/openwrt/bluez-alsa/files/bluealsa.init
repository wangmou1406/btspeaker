#!/bin/sh /etc/rc.common
# bluealsa 开机自启（OpenWrt procd）
# 同时启用 A2DP sink（手机推流到路由器）与 A2DP source（路由器推流到音箱）
START=65
USE_PROCD=1
PROG=/usr/bin/bluealsa

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_append_param command -p a2dp-sink
	procd_append_param command -p a2dp-source
	procd_append_param command -c aac
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
